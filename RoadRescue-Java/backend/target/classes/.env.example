# MySQL Configuration
DB_URL=jdbc:mysql://localhost:3306/roadrescue?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Secret (change this in production — must be at least 32 characters)
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Initial Admin Credentials
ADMIN_EMAIL=admin@roadrescue.in
ADMIN_PASSWORD=admin12345

# Server
SERVER_PORT=8080

# CORS (frontend URL)
CORS_ORIGIN=http://localhost:5173
